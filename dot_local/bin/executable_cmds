#!/usr/bin/env bash

set -o pipefail

catalog="${CMDS_CATALOG:-${XDG_DATA_HOME:-$HOME/.local/share}/cmds/commands.md}"

usage() {
  cat <<'EOF'
Usage:
  cmds [query...]          Search recipes and copy the selected command
  cmds --print [query...]  Search recipes and print only the selected command
  cmds add                 Add a recipe interactively
  cmds edit                Open the Markdown catalog
  cmds list                List indexed recipes
  cmds path                Print the catalog path
  cmds help                Show this help

Alt-S in an interactive Omarchy Bash terminal opens the picker and inserts the
selected command at the prompt without executing it.
EOF
}

ensure_catalog() {
  if [[ ! -r "$catalog" ]]; then
    printf 'cmds: catalog not found: %s\n' "$catalog" >&2
    return 1
  fi
}

list_entries() {
  awk '
    BEGIN { OFS = "\t" }

    function emit() {
      if (entry > 0 && title != "" && command != "") {
        gsub(/\t/, " ", title)
        gsub(/\t/, " ", tags)
        gsub(/\t/, " ", command)
        print entry, title, tags, command
      }
    }

    /^##[[:space:]]+/ {
      emit()
      entry++
      title = $0
      sub(/^##[[:space:]]+/, "", title)
      tags = ""
      command = ""
      in_code = 0
      next
    }

    entry > 0 && /^Tags:[[:space:]]*/ {
      tags = $0
      sub(/^Tags:[[:space:]]*/, "", tags)
      next
    }

    entry > 0 && /^```(bash|sh|shell)[[:space:]]*$/ {
      in_code = 1
      next
    }

    in_code && /^```[[:space:]]*$/ {
      in_code = 0
      next
    }

    in_code {
      line = $0
      if (command == "") {
        command = line
      } else {
        command = command "  ↵  " line
      }
    }

    END { emit() }
  ' "$catalog"
}

show_entry() {
  local target="${1:-}"

  [[ $target =~ ^[0-9]+$ ]] || return 2

  awk -v target="$target" '
    /^##[[:space:]]+/ {
      entry++
      if (showing && entry > target) exit
      showing = (entry == target)
    }
    showing { print }
  ' "$catalog"
}

get_entry_command() {
  local target="${1:-}"

  [[ $target =~ ^[0-9]+$ ]] || return 2

  awk -v target="$target" '
    /^##[[:space:]]+/ {
      entry++
      if (entry > target) exit
    }

    entry == target && /^```(bash|sh|shell)[[:space:]]*$/ {
      in_code = 1
      next
    }

    entry == target && in_code && /^```[[:space:]]*$/ {
      exit
    }

    entry == target && in_code { print }
  ' "$catalog"
}

pick_command() {
  local query="${1:-}"
  local preview_command selection entry_id

  command -v fzf >/dev/null 2>&1 || {
    printf 'cmds: fzf is required\n' >&2
    return 1
  }

  if command -v bat >/dev/null 2>&1; then
    preview_command='cmds show {1} | bat --color=always --language=md --style=plain'
  else
    preview_command='cmds show {1}'
  fi

  export CMDS_CATALOG="$catalog"

  selection="$({ list_entries; } | fzf \
    --delimiter=$'\t' \
    --with-nth=2,3,4 \
    --nth=2,3,4 \
    --query="$query" \
    --prompt='Commands › ' \
    --header='Search titles, tags, and commands • Enter selects • Esc cancels' \
    --height=85% \
    --layout=reverse \
    --border \
    --preview="$preview_command" \
    --preview-window='right,55%,wrap')" || return 1

  [[ -n $selection ]] || return 1
  entry_id="${selection%%$'\t'*}"
  get_entry_command "$entry_id"
}

copy_command() {
  local selected="$1"
  local summary="${selected//$'\n'/; }"

  if [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-copy >/dev/null 2>&1; then
    if printf '%s' "$selected" | wl-copy; then
      if command -v notify-send >/dev/null 2>&1; then
        notify-send 'Command Recipes' "Copied: ${summary:0:180}" >/dev/null 2>&1 || true
      fi
      printf 'Copied to clipboard:\n%s\n' "$selected"
      return
    fi
  fi

  printf 'Selected command:\n%s\n' "$selected"
}

add_entry() {
  local title tags command

  command -v gum >/dev/null 2>&1 || {
    printf 'cmds: gum is required for interactive entry creation\n' >&2
    return 1
  }

  title="$(gum input --header='Add a command recipe (never store secrets)' --prompt='Title: ' --placeholder='DigitalOcean — List droplets')" || return
  [[ -n $title ]] || return

  tags="$(gum input --prompt='Tags: ' --placeholder='do digitalocean droplets servers')" || return
  command="$(gum input --char-limit=0 --prompt='Command: ' --placeholder='doctl compute droplet list')" || return
  [[ -n $command ]] || return

  title="${title//$'\t'/ }"
  tags="${tags//$'\t'/ }"

  {
    printf '\n## %s\n\n' "$title"
    printf 'Tags: %s\n\n' "$tags"
    printf '```bash\n%s\n```\n' "$command"
  } >> "$catalog"

  printf 'Added “%s” to %s\n' "$title" "$catalog"
}

edit_catalog() {
  local editor="${VISUAL:-${EDITOR:-nano}}"
  "$editor" "$catalog"
}

ensure_catalog || exit 1

case "${1:-}" in
  --print)
    shift
    pick_command "$*"
    ;;
  add)
    add_entry
    ;;
  edit)
    edit_catalog
    ;;
  list)
    list_entries | awk -F '\t' '{ printf "%-3s %-42s %s\n", $1, $2, $3 }'
    ;;
  path)
    printf '%s\n' "$catalog"
    ;;
  show)
    shift
    show_entry "${1:-}"
    ;;
  get)
    shift
    get_entry_command "${1:-}"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    selected="$(pick_command "$*")" || exit 0
    [[ -n $selected ]] && copy_command "$selected"
    ;;
esac
