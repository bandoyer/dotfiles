#!/bin/bash

set -uo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
usage_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"

flags=()
only=()
declare -A excluded

while (( $# > 0 )); do
  case "$1" in
  --force | --limits-only)
    flags+=("$1")
    ;;
  --except)
    if (( $# < 2 )); then
      echo "dlb.agents update: --except needs an agent id" >&2
      exit 1
    fi
    excluded[$2]=1
    shift
    ;;
  *)
    only+=("$1")
    ;;
  esac
  shift
done

wanted() {
  local agent="$1" candidate
  [[ -n ${excluded[$agent]:-} ]] && return 1
  (( ${#only[@]} == 0 )) && return 0
  for candidate in "${only[@]}"; do
    [[ $candidate == "$agent" ]] && return 0
  done
  return 1
}

collect() {
  local agent="$1" collector="$2" record tmp
  mkdir -p "$usage_dir"
  umask 077
  if ! record=$("$collector" "${flags[@]}" </dev/null) || [[ -z $record ]]; then
    echo "dlb.agents update: $agent collector failed" >&2
    return 1
  fi
  if ! jq -e --arg agent "$agent" '.id == $agent and .schemaVersion == 1' >/dev/null 2>&1 <<<"$record"; then
    echo "dlb.agents update: $agent collector returned an invalid record" >&2
    return 1
  fi
  tmp=$(mktemp "$usage_dir/.$agent.XXXXXX")
  printf '%s\n' "$record" >"$tmp"
  mv "$tmp" "$usage_dir/$agent.json"
}

# Providers switched off in shell.json never run, whoever asked for the update.
while IFS= read -r agent; do
  [[ -n $agent ]] && excluded[$agent]=1
done < <("$script_dir/providers" list --json | jq -r '.[] | select(.enabled | not) | .id')

# Every discovered collector, this plugin's copies shadowing Omarchy's.
status=0
while IFS=$'\t' read -r agent _source collector; do
  wanted "$agent" || continue
  collect "$agent" "$collector" || status=1
done < <("$script_dir/providers" discover)

exit "$status"
