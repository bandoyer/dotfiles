{
  "version": 1,
  "idle": {
    "screensaver": 180,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "37signals.hey"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "dlb.agents"
        },
{{- if .enableMsiRgb }}
        {
          "id": "dlb.rgb"
        },
{{- end }}
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
{{- if .enableArctis }}
        {
          "id": "dlb.audio-output"
        },
{{- end }}
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "dlb.notifications"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "dlb.notifications"
  ]
}
